{
    "name": "metalinked/laravel-settings-kit",
    "description": "Typed settings for Laravel, defined in code: global values with per-user (or per-model) overrides, one query per request, translated labels and ready-made settings panels.",
    "type": "library",
    "keywords": [
        "laravel",
        "settings",
        "preferences",
        "user-settings",
        "configuration",
        "feature-flags",
        "typed-settings"
    ],
    "homepage": "https://github.com/metalinked/laravel-settings-kit",
    "license": "MIT",
    "authors": [
        {
            "name": "Metalinked",
            "email": "info@metalinked.net"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^1.12|^2.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Metalinked\\LaravelSettingsKit\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Metalinked\\LaravelSettingsKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes --verbose",
        "format-check": "vendor/bin/php-cs-fixer fix --allow-risky=yes --dry-run --diff --verbose",
        "quality": [
            "@format",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Metalinked\\LaravelSettingsKit\\SettingsKitServiceProvider"
            ],
            "aliases": {
                "Settings": "Metalinked\\LaravelSettingsKit\\Facades\\Settings"
            }
        },
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
